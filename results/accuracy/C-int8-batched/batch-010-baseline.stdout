{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "It would have been more wonderful had he spoken without a bidding.", "timestamps": [], "durations": [], "tokens":["It", " would", " have", " been", " more", " wonderful", " had", " he", " spoken", " without", " a", " bidding", "."], "ys_log_probs": [], "words": []}
{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "Notwithstanding the high resolution of Hawkeye, he fully comprehended all the difficulties and danger he was about to incur.", "timestamps": [], "durations": [], "tokens":["Not", "withstanding", " the", " high", " resolution", " of", " Haw", "key", "e", ",", " he", " fully", " compreh", "ended", " all", " the", " difficulties", " and", " danger", " he", " was", " about", " to", " incur", "."], "ys_log_probs": [], "words": []}
{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "So choose for yourself to make a rush or tarry here.", "timestamps": [], "durations": [], "tokens":["So", " choose", " for", " yourself", " to", " make", " a", " rush", " or", " t", "arry", " here", "."], "ys_log_probs": [], "words": []}
{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "Hold,\" said David, perceiving that with this assurance they were about to leave him. \"I am an unworthy and humble follower of one who taught not the damnable principle of revenge.\"", "timestamps": [], "durations": [], "tokens":["Hold", ",\"", " said", " David", ",", " per", "ceiving", " that", " with", " this", " assurance", " they", " were", " about", " to", " leave", " him", ".", " \"", "I", " am", " an", " unw", "orthy", " and", " humble", " follower", " of", " one", " who", " taught", " not", " the", " dam", "nable", " principle", " of", " revenge", ".\""], "ys_log_probs": [], "words": []}
{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "I am afraid there are no signs here,\" said he.", "timestamps": [], "durations": [], "tokens":["I", " am", " afraid", " there", " are", " no", " signs", " here", ",\"", " said", " he", "."], "ys_log_probs": [], "words": []}
{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "He was still suffering from this sudden disturbance of the quiet routine of his life.", "timestamps": [], "durations": [], "tokens":["He", " was", " still", " suffering", " from", " this", " sudden", " disturbance", " of", " the", " quiet", " routine", " of", " his", " life", "."], "ys_log_probs": [], "words": []}
{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "Anyone in the room could get out. Yes, sir.", "timestamps": [], "durations": [], "tokens":["Anyone", " in", " the", " room", " could", " get", " out", ".", " Yes", ",", " sir", "."], "ys_log_probs": [], "words": []}
{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "I cannot allow the examination to be held if one of the papers has been tampered with. The situation must be faced.", "timestamps": [], "durations": [], "tokens":["I", " cannot", " allow", " the", " examination", " to", " be", " held", " if", " one", " of", " the", " papers", " has", " been", " tam", "pered", " with", ".", " The", " situation", " must", " be", " faced", "."], "ys_log_probs": [], "words": []}
{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "You know him. I think so.", "timestamps": [], "durations": [], "tokens":["You", " know", " him", ".", " I", " think", " so", "."], "ys_log_probs": [], "words": []}
{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "Just close the door,\" said Holmes.", "timestamps": [], "durations": [], "tokens":["Just", " close", " the", " door", ",\"", " said", " Holmes", "."], "ys_log_probs": [], "words": []}
