{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "Sylas slunk away without a word of protest. Ambrose stood his ground, evidently bent on making his peace with Naomi before he left her. Seeing that I was in the way, I walked aside toward a glass door at the lower end of the room.", "timestamps": [], "durations": [], "tokens":["S", "yl", "as", " sl", "unk", " away", " without", " a", " word", " of", " protest", ".", " Amb", "rose", " stood", " his", " ground", ",", " evidently", " bent", " on", " making", " his", " peace", " with", " Naomi", " before", " he", " left", " her", ".", " Seeing", " that", " I", " was", " in", " the", " way", ",", " I", " walked", " aside", " toward", " a", " glass", " door", " at", " the", " lower", " end", " of", " the", " room", "."], "ys_log_probs": [], "words": []}
