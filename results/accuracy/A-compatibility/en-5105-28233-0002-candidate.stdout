{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "It must be owned, and no one was more ready to confess it than himself, that his literary attainments were by no means of a high order.", "timestamps": [], "durations": [], "tokens":["It", " must", " be", " owned", ",", " and", " no", " one", " was", " more", " ready", " to", " confess", " it", " than", " himself", ",", " that", " his", " literary", " attain", "ments", " were", " by", " no", " means", " of", " a", " high", " order", "."], "ys_log_probs": [], "words": []}
