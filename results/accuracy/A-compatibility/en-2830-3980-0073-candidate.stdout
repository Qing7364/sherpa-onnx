{"lang": "", "lang_probs": [], "emotion": "", "event": "", "text": "This attitude springs from a false conception of sin: the conception that sin is a small matter, easily taken care of by good works; that we must present ourselves unto God with a good conscience; that we must feel no sin before we may feel that Christ was given for our sins.", "timestamps": [], "durations": [], "tokens":["This", " attitude", " springs", " from", " a", " false", " conception", " of", " sin", ":", " the", " conception", " that", " sin", " is", " a", " small", " matter", ",", " easily", " taken", " care", " of", " by", " good", " works", ";", " that", " we", " must", " present", " ourselves", " unto", " God", " with", " a", " good", " conscience", ";", " that", " we", " must", " feel", " no", " sin", " before", " we", " may", " feel", " that", " Christ", " was", " given", " for", " our", " sins", "."], "ys_log_probs": [], "words": []}
