--- a/sherpa-onnx/csrc/offline-qwen3-asr-model.h
+++ b/sherpa-onnx/csrc/offline-qwen3-asr-model.h
@@ -7,6 +7,7 @@
 
 #include <cstdint>
 #include <memory>
+#include <utility>
 #include <vector>
 
 #include "onnxruntime_cxx_api.h"  // NOLINT
@@ -52,8 +53,9 @@ class OfflineQwen3ASRModel {
    * int64.
    * @param cache_kv  Fixed-size KV cache, vector of (key, value) pairs.
    * @return Return tuple (logits, kv_outputs...). Logits shape (N, T,
-   * vocab_size), float32. kv_outputs is a vector of (key_delta, value_delta)
-   * pairs for each layer.
+   * vocab_size), or (N, 1, vocab_size) for last-position-only projection,
+   * float32. kv_outputs is a vector of (key_delta, value_delta) pairs for
+   * each layer, always of shape (N, T, kv_h, hd) for the full input T.
    */
   std::pair<Ort::Value, std::vector<std::pair<Ort::Value, Ort::Value>>>
   ForwardLLM(Ort::Value input_ids, Ort::Value audio_features,
diff --git a/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl-test.cc b/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl-test.cc
index 3dc05ee..2b11634 100644
--- a/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl-test.cc
+++ b/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl-test.cc
@@ -4,14 +4,86 @@
 
 #include "sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl.h"
 
+#include <algorithm>
 #include <array>
 #include <cstring>
+#include <limits>
+#include <utility>
+#include <vector>
 
 #include "gtest/gtest.h"
 #include "sherpa-onnx/csrc/onnx-utils.h"
 
 namespace sherpa_onnx {
 
+struct PrefillLogitsCase {
+  std::vector<int64_t> shape;
+  int32_t context_len;
+  int32_t expected;
+};
+
+class Qwen3ASRPrefillLogitsIndexTest
+    : public ::testing::TestWithParam<PrefillLogitsCase> {};
+
+TEST_P(Qwen3ASRPrefillLogitsIndexTest, SelectsOrRejectsShape) {
+  const auto &test = GetParam();
+  EXPECT_EQ(GetQwen3ASRPrefillLogitsIndex(test.shape, test.context_len),
+            test.expected);
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    Layouts, Qwen3ASRPrefillLogitsIndexTest,
+    ::testing::ValuesIn(std::vector<PrefillLogitsCase>{
+        {{1, 8, 7}, 8, 7},
+        {{1, 10, 7}, 8, 7},
+        {{1, 1, 7}, 8, 0},
+        {{1, 1, 7}, 1, 0},
+        {{1, 4, 7}, 8, -1},
+        {{1, 0, 7}, 8, -1},
+        {{1, 1, 0}, 8, -1},
+        {{}, 8, -1},
+        {{1}, 8, -1},
+        {{1, 7}, 8, -1},
+        {{1, 1, 7, 1}, 8, -1},
+        {{0, 8, 7}, 8, -1},
+        {{2, 8, 7}, 8, -1},
+        {{-1, 8, 7}, 8, -1},
+        {{1, -1, 7}, 8, -1},
+        {{1, 8, -1}, 8, -1},
+        {{1, int64_t{std::numeric_limits<int32_t>::max()} + 1, 7}, 8, -1},
+        {{1, 8, int64_t{std::numeric_limits<int32_t>::max()} + 1}, 8, -1},
+        {{1, std::numeric_limits<int64_t>::max(), 7}, 8, -1},
+        {{1, 8, std::numeric_limits<int64_t>::max()}, 8, -1},
+        {{1, 1, 7}, 0, -1},
+        {{1, 1, 7}, -1, -1},
+        {{1, std::numeric_limits<int32_t>::max(), 7}, 8, 7},
+        {{1, 1, std::numeric_limits<int32_t>::max()}, 8, 0},
+    }));
+
+TEST(Qwen3ASRPrefillLogits, SelectedRowContainsEosAndNonEosFallback) {
+  constexpr int32_t kVocab = 7;
+  constexpr int32_t kEos = 6;
+  // Context ends at row 1. Row 2 must not be sampled even when T > context.
+  const std::vector<float> full{20, 0, 0, 0, 0, 0, 0,
+                                0, 0, 0, 8, 0, 0, 9,
+                                0, 30, 0, 0, 0, 0, 0};
+  const std::vector<float> last{0, 0, 0, 8, 0, 0, 9};
+  for (const auto &logits : {full, last}) {
+    const std::vector<int64_t> shape{
+        1, static_cast<int64_t>(logits.size() / kVocab), kVocab};
+    const int32_t index = GetQwen3ASRPrefillLogitsIndex(shape, 2);
+    ASSERT_GE(index, 0);
+    const auto begin = logits.begin() + static_cast<size_t>(index) * kVocab;
+    EXPECT_EQ(std::max_element(begin, begin + kVocab) - begin, kEos);
+    // This verifies row access, not the recognizer's private EOS policy.
+    std::vector<float> fallback(begin, begin + kVocab);
+    fallback[kEos] = -std::numeric_limits<float>::infinity();
+    EXPECT_EQ(std::max_element(fallback.begin(), fallback.end()) -
+                  fallback.begin(),
+              3);
+  }
+}
+
 // Regression test for https://github.com/k2-fsa/sherpa-onnx/issues/3509
 //
 // When every frame of audio_features is silence, TrimAudioFeatures() must
diff --git a/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl.cc b/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl.cc
index bd11716..46e09fa 100644
--- a/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl.cc
+++ b/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl.cc
@@ -6,6 +6,7 @@
 
 #include <algorithm>
 #include <array>
+#include <cinttypes>
 #include <cmath>
 #include <cstdint>
 #include <cstring>
@@ -34,6 +35,20 @@
 
 namespace sherpa_onnx {
 
+int32_t GetQwen3ASRPrefillLogitsIndex(const std::vector<int64_t> &shape,
+                                    int32_t context_len) {
+  if (shape.size() != 3 || shape[0] != 1 || context_len <= 0 ||
+      shape[1] <= 0 || shape[2] <= 0 ||
+      shape[1] > std::numeric_limits<int32_t>::max() ||
+      shape[2] > std::numeric_limits<int32_t>::max()) {
+    return -1;
+  }
+  if (shape[1] >= context_len) {
+    return context_len - 1;
+  }
+  return shape[1] == 1 ? 0 : -1;
+}
+
 namespace {
 
 // Mel-frame chunk length (in frames) assumed by the Qwen3-ASR conv frontend
@@ -967,19 +982,19 @@ OfflineRecognitionResult OfflineRecognizerQwen3ASRImpl::GenerateText(
   const int64_t eos_id = tokenizer_->GetEosTokenId();
 
   auto log_shape = logits.GetTensorTypeAndShapeInfo().GetShape();
-  if (log_shape.size() < 3) {
-    result.text = "";
-    return result;
-  }
-
-  const int32_t time_dim = static_cast<int32_t>(log_shape[1]);
-  const int32_t last_idx = context_len - 1;
-  if (last_idx >= time_dim) {
+  const int32_t last_idx =
+      GetQwen3ASRPrefillLogitsIndex(log_shape, context_len);
+  if (last_idx < 0) {
     if (config_.model_config.debug) {
       SHERPA_ONNX_LOGE(
-          "qwen3-asr: logits time_dim (%d) < context_len (%d); "
-          "cannot sample first token",
-          time_dim, context_len);
+          "qwen3-asr: invalid prefill logits shape: rank=%d batch=%" PRId64
+          " time=%" PRId64 " vocab=%" PRId64
+          " context_len=%d; cannot sample first token",
+          static_cast<int32_t>(log_shape.size()),
+          log_shape.empty() ? int64_t{-1} : log_shape[0],
+          log_shape.size() > 1 ? log_shape[1] : int64_t{-1},
+          log_shape.size() > 2 ? log_shape[2] : int64_t{-1},
+          context_len);
     }
     result.text = "";
     return result;
diff --git a/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl.h b/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl.h
index 92f96e3..71ad15d 100644
--- a/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl.h
+++ b/sherpa-onnx/csrc/offline-recognizer-qwen3-asr-impl.h
@@ -21,6 +21,12 @@
 
 namespace sherpa_onnx {
 
+// Select the prefill row for full [1, T, V] or last-only [1, 1, V] logits.
+// Full outputs with T >= context_len retain row context_len - 1.
+// Returns -1 for invalid shapes or dimensions outside the int32 sampler range.
+int32_t GetQwen3ASRPrefillLogitsIndex(const std::vector<int64_t> &shape,
+                                    int32_t context_len);
+
